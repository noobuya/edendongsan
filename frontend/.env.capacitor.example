# APK(Capacitor)로 빌드할 때 쓰는 환경변수 템플릿.
#
# 이 파일을 .env.local로 복사해서 값을 채운 뒤 `npm run build:capacitor`를
# 실행하세요 — 안드로이드 기기 입장에서 "localhost"는 앱을 실행 중인 그 폰
# 자신을 가리키므로, PC에서 돌아가는 백엔드에 절대 닿지 않습니다. ngrok 등으로
# 외부에서 접근 가능한 주소를 발급받아 넣어야 합니다.
#
#   1) run_backend.bat 으로 백엔드(8000번 포트)를 켠 상태에서
#   2) ngrok http 8000 실행 → https://xxxx-xxxx.ngrok-free.app 같은 주소 발급
#   3) 그 주소를 아래에 넣기 (끝에 슬래시(/) 붙이지 않기)
#
# ngrok 무료 플랜은 껐다 켤 때마다 주소가 바뀌므로, 재발급될 때마다 이 값을
# 갱신하고 `npm run build:capacitor && npx cap sync android`를 다시 돌려야
# 새 주소가 앱(APK)에 반영됩니다.
NEXT_PUBLIC_API_URL=https://your-ngrok-subdomain.ngrok-free.app
